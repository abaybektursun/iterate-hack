{
  "extraKnownMarketplaces": {
    "pastdotdev": {
      "source": {
        "source": "github",
        "repo": "pastdotdev/claude-code-plugin"
      }
    }
  },
  "enabledPlugins": {
    "pastdotdev@pastdotdev": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet tools/msg.py read --hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
