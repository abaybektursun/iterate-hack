diff --git a/studies/gapmap/lib/cells.py b/studies/gapmap/lib/cells.py
new file mode 100644
index 0000000..a5aca70
--- /dev/null
+++ b/studies/gapmap/lib/cells.py
@@ -0,0 +1,61 @@
+"""Check the settings of gapmap cells before any job runs. Standard library only, so it runs on a laptop in under a
+second: it reads settings, it computes nothing.
+
+  python3 studies/gapmap/lib/cells.py <batch> [<cell>]     exits 1 with every problem found
+
+Used by prep/make_cells.py (after writing), jobs/submit.sh (before launching) and jobs/cell.py (before the bootstrap).
+"""
+import json
+import sys
+from pathlib import Path
+
+STUDY = Path(__file__).resolve().parent.parent
+FMTS = ("json", "csv")  # the keys of WRITERS in jobs/cell.py
+N_BOOT, SEED = 1500000, 0  # specs/SPEC.md, Requirement 2
+
+
+def problems(cell, queue):
+    """Every invalid setting of one cell, as text. Empty when the cell is valid."""
+    found = []
+    kind = cell.get("kind")
+    if kind == "bench":
+        s = cell.get("seconds_per_generator")
+        if not (isinstance(s, (int, float)) and s > 0):
+            found.append(f"seconds_per_generator {s!r} must be a positive number")
+        return found
+    if kind != "split":
+        return [f"kind {kind!r} must be split or bench"]
+    if cell.get("metric") not in queue["batches"]:
+        found.append(f"metric {cell.get('metric')!r} must be one of {queue['batches']}")
+    if cell.get("split") not in queue["splits"]:
+        found.append(f"split {cell.get('split')!r} must be one of {queue['splits']}")
+    ci = cell.get("ci")
+    if not (isinstance(ci, float) and 0 < ci < 1):
+        found.append(f"ci {ci!r} must be a fraction between 0 and 1, such as 0.9")
+    if cell.get("fmt") not in FMTS:
+        found.append(f"fmt {cell.get('fmt')!r} must be one of {list(FMTS)}")
+    digits = cell.get("digits")
+    if not (isinstance(digits, int) and 1 <= digits <= 10):
+        found.append(f"digits {digits!r} must be an integer from 1 to 10")
+    if cell.get("n_boot") != N_BOOT or cell.get("seed") != SEED:
+        found.append(f"n_boot {cell.get('n_boot')!r} and seed {cell.get('seed')!r} must be {N_BOOT} and {SEED} (SPEC, Requirement 2)")
+    return found
+
+
+def check(batch, only=None):
+    """Raise SystemExit listing every problem in cells/<batch>.json (or in its one cell `only`)."""
+    queue = json.loads((STUDY / "queue.json").read_text())
+    cells = json.loads((STUDY / "cells" / f"{batch}.json").read_text())
+    ids = [c.get("id") for c in cells]
+    if only is not None and only not in ids:
+        raise SystemExit(f"cells/{batch}.json has no cell {only!r}; cells: {ids}")
+    found = [f"cell {c.get('id')!r}: {p}" for c in cells if only in (None, c.get("id")) for p in problems(c, queue)]
+    if len(set(ids)) != len(ids):
+        found.append(f"duplicate cell ids: {ids}")
+    if found:
+        raise SystemExit(f"cells/{batch}.json is invalid:\n  " + "\n  ".join(found))
+
+
+if __name__ == "__main__":
+    check(sys.argv[1], sys.argv[2] if len(sys.argv) > 2 else None)
+    print(f"cells/{sys.argv[1]}.json ok")
