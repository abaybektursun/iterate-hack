+        assert c["metric"] in queue["batches"], f"{c['id']}: metric {c['metric']!r}"
+        assert c["split"] in queue["splits"], f"{c['id']}: split {c['split']!r}"
+        assert type(c["n_boot"]) is int and c["n_boot"] > 0, f"{c['id']}: n_boot {c['n_boot']!r}"
+        assert type(c["ci"]) is float and 0 < c["ci"] < 1, f"{c['id']}: ci {c['ci']!r} must be a float in (0, 1)"
+        assert c["fmt"] in ("json", "csv"), f"{c['id']}: fmt {c['fmt']!r} must be json or csv"
+        assert type(c["digits"]) is int and 0 <= c["digits"] <= 10, f"{c['id']}: digits {c['digits']!r} must be an int"
+
+
+if sys.argv[1] == "--check":
+    check(json.loads(Path(sys.argv[2]).read_text()))
+    print(f"cells ok: {sys.argv[2]}")
+    sys.exit(0)
 batch = sys.argv[1]
 assert batch in queue["batches"], f"batch must be one of {queue['batches']}"
 cells = [{"id": split, "kind": "split", "metric": batch, "split": split, **queue["defaults"]} for split in queue["splits"]]
 cells += [{"seed": queue["defaults"]["seed"], **extra} for extra in queue["extras"]]
+check(cells)
 (study / "cells").mkdir(exist_ok=True)
 (study / "cells" / f"{batch}.json").write_text(json.dumps(cells, indent=1) + "\n")
 print(f"{len(cells)} cells: " + ", ".join(c["id"] for c in cells))