--- a/studies/gapmap/prep/make_cells.py
+++ b/studies/gapmap/prep/make_cells.py
@@ -2,18 +2,39 @@
 
   python3 studies/gapmap/prep/make_cells.py <batch>      writes studies/gapmap/cells/<batch>.json
 
-A batch is one metric. Edit a cell in the written file to give it its own settings (interval level, table format, digits).
+A cell's own settings (interval level, table format, digits; the subject split, SPEC requirement 3) go in
+queue.json under "settings": {"<batch>": {"<cell id>": {...}}}, not as a hand edit of the written file. Every cell
+is checked with jobs/check_cell.py before the file is written; nothing is written if one fails.
 """
 import json
 import sys
 from pathlib import Path
 
 study = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(study / "jobs"))
+import check_cell  # noqa: E402
+
 queue = json.loads((study / "queue.json").read_text())
 batch = sys.argv[1]
 assert batch in queue["batches"], f"batch must be one of {queue['batches']}"
+settings = queue.get("settings", {}).get(batch, {})
 cells = [{"id": split, "kind": "split", "metric": batch, "split": split, **queue["defaults"]} for split in queue["splits"]]
 cells += [{"seed": queue["defaults"]["seed"], **extra} for extra in queue["extras"]]
-(study / "cells").mkdir(exist_ok=True)
-(study / "cells" / f"{batch}.json").write_text(json.dumps(cells, indent=1) + "\n")
-print(f"{len(cells)} cells: " + ", ".join(c["id"] for c in cells))
+ids = [c["id"] for c in cells]
+unknown = sorted(set(settings) - set(ids))
+assert not unknown, f"queue.json settings for {batch} name cells {unknown} that do not exist; ids: {ids}"
+for cell in cells:
+    for key, value in settings.get(cell["id"], {}).items():
+        assert key in cell, f"queue.json settings for {batch}/{cell['id']}: unknown key {key!r}"
+        cell[key] = value
+
+out = study / "cells" / f"{batch}.json"
+tmp = out.with_suffix(".check.json")
+out.parent.mkdir(exist_ok=True)
+tmp.write_text(json.dumps(cells, indent=1) + "\n")
+found = [f"{cid}: {p}" for cid in ids for p in check_cell.problems(tmp, cid, check_cell.DATA)]
+tmp.unlink()
+if found:
+    sys.exit("make_cells: not written, fix queue.json:\n  " + "\n  ".join(found))
+out.write_text(json.dumps(cells, indent=1) + "\n")
+print(f"{len(cells)} cells: " + ", ".join(f"{c['id']}{' ' + str(settings[c['id']]) if c['id'] in settings else ''}" for c in cells))
