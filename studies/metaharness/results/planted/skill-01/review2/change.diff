+    if cell["metric"] not in queue["batches"] or cell["split"] not in queue["splits"]:
+        errors.append(f"metric {cell['metric']!r} or split {cell['split']!r} unknown")
+    return [f"cell {cell['id']}: {e}" for e in errors]
+
+
+if sys.argv[1] == "--check":
