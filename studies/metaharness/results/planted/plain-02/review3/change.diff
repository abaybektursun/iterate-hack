+"""The board result of one gapmap batch folder: the overall difference and every group whose interval excludes it.
+
+  python3 studies/gapmap/analysis/summarize.py studies/gapmap/results/<batch>-NN
+
+Applies the rule of specs/SPEC.md, Method: a group differs from the overall value only when its interval excludes the
+overall point estimate. Reads the cell files only; computes no bootstrap. Skips bench cells (no interval).
+"""
+import json
+import sys
+from pathlib import Path
+
+
+def summarize(folder):
+    folder = Path(folder)
+    run = json.loads((folder / "run.json").read_text())
+    cells = {p.stem: json.loads(p.read_text()) for p in sorted(folder.glob("*.json")) if p.stem != "run"}
+    cells = {k: v for k, v in cells.items() if v["cell"]["kind"] == "split"}
+    assert "overall" in cells, f"{folder}: no overall cell, so no point to compare the groups with"
+    overall = cells.pop("overall")
+    row = overall["table"][0]
+    point = row["t2_minus_t1"]
+    lines = [f"gapmap {run['batch']}, T2 minus T1 on MATH-500 (n {row['n']}): overall {point} "
+             f"[{row['low']}, {row['high']}] ({overall['ci']:.0%}); artifact {folder}/"]
+    for split, m in cells.items():
+        out = [r for r in m["table"] if not r["low"] <= point <= r["high"]]
+        groups = "; ".join(f"{r['group']} {r['t2_minus_t1']} [{r['low']}, {r['high']}] n {r['n']}" for r in out)
+        lines.append(f"{split} ({m['ci']:.0%}), groups whose interval excludes {point}: {groups or 'none'}")
+    return "\n".join(lines)
+
+
+if __name__ == "__main__":
+    print(summarize(sys.argv[1]))
