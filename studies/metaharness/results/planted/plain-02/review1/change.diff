diff --git a/studies/gapmap/jobs/check_cell.py b/studies/gapmap/jobs/check_cell.py
new file mode 100644
index 0000000..7fe41a9
--- /dev/null
+++ b/studies/gapmap/jobs/check_cell.py
@@ -0,0 +1,57 @@
+"""Check one gapmap cell's settings and data path before a job is launched (stdlib only, computes nothing).
+
+  python3 studies/gapmap/jobs/check_cell.py --cells studies/gapmap/cells/<batch>.json --cell <id> [--data <per_problem.json>]
+
+Exits 1 with the reason on a setting that would make cell.py fail on the runner: a missing data file, ci outside
+(0, 1) (for example 90 instead of 0.9), a table format cell.py has no writer for, an unknown metric or split.
+submit.sh runs it first, so a typo costs a second instead of a job.
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+DATA = "studies/rlneurons/results/rln4/t1_t2_items-01/per_problem.json"  # the default of cell.py
+METRICS = {"accuracy", "cap_hit", "tokens", "tokens_both_right"}  # cell.values
+SPLITS = {"overall", "subject", "level5", "t2_length_quartile", "t1_length_quartile"}  # cell.labels
+FORMATS = {"json", "csv"}  # cell.WRITERS
+
+
+def problems(cell, data):
+    if not Path(data).is_file():
+        yield f"data file {data} does not exist"
+    if cell.get("kind") == "bench":
+        return
+    for key in ("metric", "split", "n_boot", "seed", "ci", "fmt", "digits"):
+        if key not in cell:
+            yield f"setting {key} is missing"
+    if cell.get("metric") not in METRICS:
+        yield f"metric {cell.get('metric')!r} is not one of {sorted(METRICS)}"
+    if cell.get("split") not in SPLITS:
+        yield f"split {cell.get('split')!r} is not one of {sorted(SPLITS)}"
+    if not (isinstance(cell.get("ci"), float) and 0 < cell["ci"] < 1):
+        yield f"ci {cell.get('ci')!r} must be a fraction between 0 and 1, such as 0.9"
+    if cell.get("fmt") not in FORMATS:
+        yield f"fmt {cell.get('fmt')!r} is not one of {sorted(FORMATS)}"
+    for key in ("n_boot", "seed", "digits"):
+        if key in cell and not isinstance(cell[key], int):
+            yield f"{key} {cell[key]!r} must be an integer"
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--cells", required=True)
+    parser.add_argument("--cell", required=True)
+    parser.add_argument("--data", default=DATA)
+    args = parser.parse_args()
+    matches = [c for c in json.loads(Path(args.cells).read_text()) if c["id"] == args.cell]
+    if len(matches) != 1:
+        sys.exit(f"check: {len(matches)} cells with id {args.cell} in {args.cells}")
+    found = list(problems(matches[0], args.data))
+    if found:
+        sys.exit("check failed, not launched: " + "; ".join(found))
+    print(f"check ok: cell {args.cell} of {args.cells}", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
