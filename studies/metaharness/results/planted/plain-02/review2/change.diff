+"""Run every cell of one gapmap batch at once and write results/<batch>-NN/ (stdlib only, computes nothing here).
+
+  python3 studies/gapmap/jobs/submit_batch.py <batch> [--data <per_problem.json>]
+
+1. Checks every cell with check_cell.py and that HEAD is pushed; launches nothing if one check fails.
+2. Starts submit.sh for all cells in parallel (each runs its cell and the verification rerun).
+3. Copies each cell's runs/<job id>/metrics.json to the next free results/<batch>-NN/<cell>.json and writes run.json.
+Exits 1, after printing the failed cells' output, if any cell fails; then it writes no results folder.
+"""
+import argparse
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+STUDY = Path("studies/gapmap")
+
+
+def git(*args):
+    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout.strip()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("batch")
+    parser.add_argument("--data")
+    args = parser.parse_args()
+    extra = ["--data", args.data] if args.data else []
+    cells_path = STUDY / "cells" / f"{args.batch}.json"
+    ids = [c["id"] for c in json.loads(cells_path.read_text())]
+
+    failed = [i for i in ids if subprocess.run(
+        ["python3", str(STUDY / "jobs/check_cell.py"), "--cells", str(cells_path), "--cell", i, *extra]).returncode]
+    if failed:
+        sys.exit(f"batch {args.batch}: cells {failed} failed their check, nothing launched")
+    commit = git("rev-parse", "HEAD")
+    if not git("branch", "-r", "--contains", commit):
+        sys.exit(f"batch {args.batch}: commit {commit[:7]} is not pushed, and a job runs only a pushed commit")
+
+    procs = {i: subprocess.Popen(["bash", str(STUDY / "jobs/submit.sh"), args.batch, i, *extra],
+                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) for i in ids}
+    print(f"batch {args.batch}: launched {len(ids)} cells at commit {commit[:7]}: {', '.join(ids)}", file=sys.stderr)
+    outputs = {i: p.communicate()[0] for i, p in procs.items()}
+    bad = [i for i, p in procs.items() if p.returncode]
+    for i in bad:
+        print(f"--- cell {i} failed:\n{outputs[i]}", file=sys.stderr)
+    if bad:
+        sys.exit(f"batch {args.batch}: cells {bad} failed, no results folder written")
+
+    jobs = {}
+    for i in ids:
+        result = [line for line in outputs[i].splitlines() if line.startswith("result runs/")]
+        assert len(result) == 1, f"cell {i}: expected one 'result runs/...' line, got:\n{outputs[i]}"
+        jobs[i] = result[0].split("/")[1]
+    n = 1
+    while (STUDY / "results" / f"{args.batch}-{n:02d}").exists():
+        n += 1
+    out = STUDY / "results" / f"{args.batch}-{n:02d}"
+    out.mkdir(parents=True)
+    for i, job in jobs.items():
+        shutil.copy(Path("runs") / job / "metrics.json", out / f"{i}.json")
+    launch = f"python3 studies/gapmap/jobs/submit_batch.py {args.batch}" + (f" --data {args.data}" if args.data else "")
+    (out / "run.json").write_text(json.dumps(
+        {"batch": args.batch, "commit": commit, "launch": [launch], "jobs": jobs}, indent=1) + "\n")
+    print(f"wrote {out}: " + ", ".join(f"{i} {j}" for i, j in jobs.items()))
+
+
+if __name__ == "__main__":
+    main()