@@ -0,0 +1,33 @@
+"""Print the board result text of one finished batch, from its committed cell files.
+
+  python3 studies/gapmap/analysis/summarize.py <batch>-NN      e.g. accuracy-01
+
+Each split line states its own interval level, because the level is set per cell (specs/SPEC.md, Requirements 3) and
+batches mix levels. A group whose interval excludes the overall point estimate (results/overall-01/metrics.json) is
+marked with `*`: that is the SPEC's rule for "different from the overall value". No number is computed here; the
+script only reads and formats the cells' metrics.json copies.
+"""
+import json
+import sys
+from pathlib import Path
+
+study = Path(__file__).resolve().parent.parent
+run = study / "results" / sys.argv[1]
+assert run.is_dir(), f"no batch folder {run}"
+cells = sorted(p for p in run.glob("*.json") if p.name != "run.json")
+assert cells, f"no cell files in {run}"
+metric = json.loads(cells[0].read_text())["cell"]["metric"]
+(overall,) = json.loads((study / "results/overall-01/metrics.json").read_text())["metrics"][metric]
+point = overall["t2_minus_t1"]
+
+print(f"gapmap {metric}, T2 minus T1 on MATH-500, paired bootstrap; artifact studies/gapmap/results/{run.name}/")
+print(f"overall {point} [{overall['low']}, {overall['high']}] (95%); * = interval excludes the overall {point}")
+for path in cells:
+    result = json.loads(path.read_text())
+    cell = result["cell"]
+    assert cell["metric"] == metric, f"{path.name} has metric {cell['metric']}, batch has {metric}"
+    groups = []
+    for row in result["table"]:
+        mark = "*" if not row["low"] <= point <= row["high"] else ""
+        groups.append(f"{row['group']} (n {row['n']}) {row['t2_minus_t1']} [{row['low']}, {row['high']}]{mark}")
+    print(f"{cell['split']} ({cell['ci']:.0%} interval): " + "; ".join(groups))