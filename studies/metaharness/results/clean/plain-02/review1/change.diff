+"""Launch every cell of one batch on the runner at once, wait for all, and write results/<batch>-NN/.
+
+  python3 studies/gapmap/jobs/submit_batch.py <batch>
+
+Each cell runs through jobs/submit.sh (one CPU job per cell, from the pushed commit). When all cells are done it copies
+runs/<job id>/metrics.json to results/<batch>-NN/<cell>.json (NN is the next free number) and writes run.json.
+Exits 1, writing nothing, if any cell fails.
+"""
+import json
+import subprocess
+import sys
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+study = Path(__file__).resolve().parent.parent
+root = study.parent.parent
+batch = sys.argv[1]
+cells = [c["id"] for c in json.loads((study / "cells" / f"{batch}.json").read_text())]
+
+
+def launch(cell):
+    """Run submit.sh for one cell; return its job id, read from the 'result runs/<job id>/metrics.json' line."""
+    done = subprocess.run(["bash", "studies/gapmap/jobs/submit.sh", batch, cell], cwd=root, capture_output=True, text=True)
+    sys.stderr.write(done.stderr)
+    if done.returncode != 0:
+        return cell, None
+    line = done.stdout.strip().splitlines()[-1]
+    assert line.startswith("result runs/"), f"cell {cell}: unexpected submit.sh output {done.stdout!r}"
+    return cell, line.split("/")[1]
+
+
+# The commit the jobs run: gpu.py submits HEAD and refuses a dirty tree.
+commit = subprocess.run(["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True, check=True).stdout.strip()
+print(f"launching {len(cells)} cells of batch {batch}: {', '.join(cells)}", flush=True)
+with ThreadPoolExecutor(len(cells)) as pool:
+    jobs = dict(pool.map(launch, cells))
+failed = [cell for cell, job in jobs.items() if job is None]
+if failed:
+    sys.exit(f"failed cells: {', '.join(failed)}; nothing written")
+
+taken = [int(p.name.rsplit("-", 1)[1]) for p in (study / "results").glob(f"{batch}-[0-9][0-9]")]
+out = study / "results" / f"{batch}-{1 + max(taken, default=0):02d}"
+out.mkdir()
+for cell, job in jobs.items():
+    (out / f"{cell}.json").write_text((root / "runs" / job / "metrics.json").read_text())
+run = {"batch": batch, "commit": commit, "launch": [f"python3 studies/gapmap/jobs/submit_batch.py {batch}"], "jobs": jobs}
+(out / "run.json").write_text(json.dumps(run, indent=1) + "\n")
+print(f"wrote {out.relative_to(root)}")
+for cell in cells:
+    for row in json.loads((out / f"{cell}.json").read_text())["table"]:
+        print(f"{cell}: {row['group']} n {row['n']} {row['t2_minus_t1']} [{row['low']}, {row['high']}]")